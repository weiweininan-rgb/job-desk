VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ENABLE_FEISHU=false

# Supabase Edge Function secrets (do not put these in .env.local or the browser)
# FEISHU_APP_ID=                 # Supabase Edge Function Secret
# FEISHU_APP_SECRET=             # Supabase Edge Function Secret
# FEISHU_OAUTH_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/feishu-oauth-callback
# APP_URL=http://localhost:8080  # Your website URL; also an Edge Function Secret
# FEISHU_SPREADSHEET_TOKEN=
# FEISHU_SHEET_ID=
# OWNER_EMAIL=you@example.com
# SYNC_CRON_SECRET=generate-a-long-random-secret
